global
  log stdout format raw daemon "${LOG_LEVEL}"
  pidfile /run/haproxy.pid
  maxconn 4000
  nbthread 2

defaults
  mode http
  log global
  option httplog
  option dontlognull
  option http-server-close
  option redispatch
  retries 3
  timeout http-request 10s
  timeout queue 1m
  timeout connect 10s
  timeout client 10m
  timeout server 10m
  timeout http-keep-alive 10s
  timeout check 10s
  maxconn 3000

backend dockerbackend
  server dockersocket /var/run/docker.sock

backend dockerstream
  option abortonclose
  server dockersocket /var/run/docker.sock
  timeout server 0
  timeout server-fin 5s

frontend dockerfrontend
  bind ${BIND_CONFIG}
  timeout client-fin 5s
  http-request deny unless METH_GET

  # 只允许 Alloy 发现/读取日志及事件观察器订阅所需的精确只读接口。
  http-request allow if { path,url_dec -m reg -i ^(/v[0-9.]+)?/_ping/?$ }
  http-request allow if { path,url_dec -m reg -i ^(/v[0-9.]+)?/version/?$ }
  http-request allow if { path,url_dec -m reg -i ^(/v[0-9.]+)?/containers/json/?$ }
  http-request allow if { path,url_dec -m reg -i ^(/v[0-9.]+)?/containers/[a-zA-Z0-9_.-]+/json/?$ }
  http-request allow if { path,url_dec -m reg -i ^(/v[0-9.]+)?/containers/[a-zA-Z0-9_.-]+/logs/?$ }
  http-request allow if { path,url_dec -m reg -i ^(/v[0-9.]+)?/networks(/[a-zA-Z0-9_.:-]+)?/?$ }
  http-request allow if { path,url_dec -m reg -i ^(/v[0-9.]+)?/events/?$ }
  http-request deny

  default_backend dockerbackend
  use_backend dockerstream if { path,url_dec -m reg -i ^(/v[0-9.]+)?/(events|containers/[a-zA-Z0-9_.-]+/logs)/? }
