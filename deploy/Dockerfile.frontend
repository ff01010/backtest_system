FROM node:22-alpine AS build

WORKDIR /app
ARG VITE_APPLICATION_BUILD_ID=dev
ARG VITE_CLIENT_COMPATIBILITY_VERSION=1
ENV VITE_APPLICATION_BUILD_ID=$VITE_APPLICATION_BUILD_ID \
  VITE_CLIENT_COMPATIBILITY_VERSION=$VITE_CLIENT_COMPATIBILITY_VERSION
COPY frontend/package.json frontend/package-lock.json ./
RUN npm ci
COPY frontend ./
RUN npm run build \
  && printf '{"buildId":"%s","clientCompatibilityVersion":%s}\n' \
    "$VITE_APPLICATION_BUILD_ID" "$VITE_CLIENT_COMPATIBILITY_VERSION" \
    > /app/dist/build-info.json

FROM nginx:1.27-alpine

ARG VITE_APPLICATION_BUILD_ID=dev
ARG VITE_CLIENT_COMPATIBILITY_VERSION=1
LABEL io.trend-grid.application-build-id=$VITE_APPLICATION_BUILD_ID \
  io.trend-grid.client-compatibility-version=$VITE_CLIENT_COMPATIBILITY_VERSION

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html
EXPOSE 80
