# 仅在服务器复制为 deploy/.env 后填写真实值；不得提交 deploy/.env。
POSTGRES_USER=quant_backtest_bootstrap
POSTGRES_PASSWORD=replace-with-a-long-random-bootstrap-password
POSTGRES_DB=postgres

APP_DB_NAME=quant_backtest_platform
APP_DB_USER=quant_backtest_app
APP_DB_PASSWORD=replace-with-a-long-random-app-password
# 仅供 release-admin 执行发布状态受控函数，必须与应用数据库密码不同。
RELEASE_DB_PASSWORD=replace-with-a-different-long-random-release-password

TREND_GRID_DEFAULT_USER_ID=00000000-0000-0000-0000-000000000001
APP_HTTP_PORT=8080

# 对外回测 API 默认关闭；启用时必须在服务器 deploy/.env 中单独设置长度不少于 32 的私有 pepper。
TREND_GRID_PUBLIC_API_ENABLED=false
TREND_GRID_API_KEY_PEPPER=
TREND_GRID_PUBLIC_API_MAX_INFLIGHT=2
TREND_GRID_PUBLIC_API_DAILY_SUBMIT_LIMIT=100

# Cookie 写请求除请求自身同源外允许的额外浏览器 Origin，逗号分隔；生产同源部署默认留空。
TREND_GRID_CSRF_TRUSTED_ORIGINS=

# 用户连续无操作达到该时长后，会话失效并要求重新登录。
TREND_GRID_AUTH_SESSION_IDLE_HOURS=24
# 单次登录的最长有效天数；即使持续操作，达到该期限后也必须重新登录。
TREND_GRID_AUTH_SESSION_MAX_DAYS=7
# 最近活动时间的最小写入间隔，用于减少高频接口轮询造成的数据库写入。
TREND_GRID_AUTH_SESSION_TOUCH_INTERVAL_SECONDS=300

# 单标有限网格实验保持关闭，完成标准 Bar 容量与发布门禁后再同时开启。
TREND_GRID_EXPERIMENTS_ENABLED=false
TREND_GRID_EXPERIMENT_BAR_ENABLED=false
TREND_GRID_EXPERIMENT_MAX_VALUES_PER_DIMENSION=50
# rolling_window_v1 激活且满足收缩条件前必须保留以下旧语义回退值。
TREND_GRID_EXPERIMENT_MAX_TRIALS=1000
TREND_GRID_EXPERIMENT_MAX_USER_PLANNED_TRIALS=10000
TREND_GRID_EXPERIMENT_BAR_MAX_ESTIMATED_BARS=10000000
TREND_GRID_EXPERIMENT_PREVIEW_TTL_SECONDS=900
TREND_GRID_EXPERIMENT_GENERATION_BATCH_SIZE=100
TREND_GRID_EXPERIMENT_MAX_IN_FLIGHT_PER_EXPERIMENT=1
TREND_GRID_EXPERIMENT_MAX_IN_FLIGHT_PER_USER=1
TREND_GRID_EXPERIMENT_MANUAL_RESERVED_PERMITS=1
TREND_GRID_EXPERIMENT_MANUAL_MAX_WAIT_SECONDS=60
TREND_GRID_EXPERIMENT_CURSOR_SIGNING_SECRET=
TREND_GRID_EXPERIMENT_COORDINATOR_LEASE_SECONDS=30
TREND_GRID_EXPERIMENT_COORDINATOR_HEARTBEAT_SECONDS=5
TREND_GRID_EXPERIMENT_COORDINATOR_POLL_SECONDS=1
# 以下容量必须按服务器真实卷容量配置；留空时自动化实验故障安全停止新生成/物化。
TREND_GRID_EXPERIMENT_POSTGRES_LOGICAL_HIGH_WATER_BYTES=
TREND_GRID_EXPERIMENT_POSTGRES_LOGICAL_LOW_WATER_BYTES=
TREND_GRID_EXPERIMENT_POSTGRES_VOLUME_MIN_FREE_BYTES=
TREND_GRID_EXPERIMENT_POSTGRES_VOLUME_RESUME_FREE_BYTES=
TREND_GRID_EXPERIMENT_ARTIFACT_VOLUME_MIN_FREE_BYTES=
TREND_GRID_EXPERIMENT_ARTIFACT_VOLUME_RESUME_FREE_BYTES=
TREND_GRID_EXPERIMENT_STORAGE_SIGNAL_MAX_AGE_SECONDS=
TREND_GRID_EXPERIMENT_STORAGE_PROBE_URL=http://storage-probe:8091
TREND_GRID_EXPERIMENT_PURGE_ENABLED=false
TREND_GRID_EXPERIMENT_PURGE_RETENTION_DAYS=30
TREND_GRID_EXPERIMENT_PURGE_BATCH_SIZE=100
TREND_GRID_EXPERIMENT_PURGE_LEASE_SECONDS=60
TREND_GRID_EXPERIMENT_PURGE_RETRY_DELAY_SECONDS=30
TREND_GRID_EXPERIMENT_PURGE_MAX_ATTEMPTS=5

# 宿主机目录；容器内分别映射为 /data/kline、/data/signals。
TREND_GRID_HOST_KLINE_ROOT=/srv/quant-backtest/data/kline
TREND_GRID_HOST_SIGNAL_ROOT=/srv/quant-backtest/data/signals

# 服务器 ClickHouse 中的 QMT 原始历史数据。密码只写入 deploy/.env。
TREND_GRID_CLICKHOUSE_HTTP_URL=http://quant-clickhouse:8123
TREND_GRID_CLICKHOUSE_USER=default
TREND_GRID_CLICKHOUSE_PASSWORD=replace-with-clickhouse-default-password

# 全局默认 A 股费用；由后端、bar-runner、l2-runner 共同使用。
TREND_GRID_DEFAULT_COMMISSION_RATE=0.00008
TREND_GRID_DEFAULT_TRANSFER_FEE_RATE=0.00001
TREND_GRID_DEFAULT_STAMP_DUTY_RATE=0.0005
TREND_GRID_DEFAULT_MINIMUM_COMMISSION=5

# L2 数据映射只能由部署管理员配置。表名、列名必须与实际 ClickHouse schema 一致。
# 未配置正式 BAR 映射时，l2_quote 回测会临时从 quant.tick_quote 按交易时段聚合 Bar；
# 正式 BAR 映射配置后优先使用正式表。不会回退到 Bar 收盘价成交。
# EVENT 映射必须包含 event_type 列及 tradeValue（例如 trade），只允许逐笔成交进入被动撮合。
TREND_GRID_L2_BAR_MAPPING_JSON=
TREND_GRID_L2_QUOTE_MAPPING_JSON=
TREND_GRID_L2_EVENT_MAPPING_JSON=
TREND_GRID_L2_BAR_CACHE_TTL_SECONDS=2592000
TREND_GRID_L2_TEMP_BAR_AGGREGATION_VERSION=tick_quote_session_v5
TREND_GRID_L2_TEMP_MAPPING_VERSION=tick_quote_depth_v3
# 订单等待成交时，每次从 ClickHouse 预取的后续十档快照数量（16 至 512）。
TREND_GRID_L2_QUOTE_PREFETCH_SIZE=128
# 默认提供 16 个 Bar 与 16 个 L2 Runner；全局槽位限制常态并发为 16，公平突发最多 24。
# Runner 是候选执行器，不代表 32 个任务会同时运行。
TREND_GRID_BAR_RUNNER_REPLICAS=16

# 标准 Bar 行情跨进程传输模式；首次发布与回滚保持 legacy，完成全部验收后才切换 auto。
TREND_GRID_BAR_IPC_MODE=legacy

# 每个 Bar Runner 容器的 /dev/shm 上限；auto 模式最多使用其中 75%。
TREND_GRID_BAR_RUNNER_SHM_SIZE_BYTES=134217728
TREND_GRID_L2_RUNNER_REPLICAS=16
TREND_GRID_BACKTEST_BASE_CONCURRENCY=16
TREND_GRID_BACKTEST_BURST_MAX_CONCURRENCY=24
TREND_GRID_BACKTEST_USER_GUARANTEED_CONCURRENCY=1
TREND_GRID_BACKTEST_FAIRNESS_BURST_ENABLED=true
TREND_GRID_BACKTEST_CANCEL_POLL_SECONDS=1
TREND_GRID_BACKTEST_CANCEL_GRACE_SECONDS=5
TREND_GRID_BACKTEST_CAPACITY_OVERRIDE_MAX_TTL_SECONDS=3600
TREND_GRID_BACKTEST_RUNNER_HEALTH_TTL_SECONDS=30
TREND_GRID_BACKTEST_RUNNER_HEARTBEAT_WRITE_SECONDS=10
TREND_GRID_BACKTEST_RUNNER_ERROR_BACKOFF_MAX_SECONDS=30
TREND_GRID_BACKTEST_RUNNER_AVAILABILITY_REQUIRED=true
# 任务级集中日志。首次发布先保持 false，验证 Loki/Alloy 采集后再开启管理员查询。
TREND_GRID_OBSERVABILITY_ENABLED=false
TREND_GRID_ENVIRONMENT=production
# 运维日志默认保留 30 天；不得配置为无限期。
TREND_GRID_LOG_RETENTION_HOURS=720
TREND_GRID_LOG_QUERY_TIMEOUT_SECONDS=3
TREND_GRID_LOG_QUERY_MAX_LINES=500
TREND_GRID_LOG_QUERY_MAX_HOURS=744
# 每个长期运行容器最多约 100 MiB 本地日志缓冲，溢出时不阻塞回测。
TREND_GRID_LOG_LOCAL_MAX_SIZE=20m
TREND_GRID_LOG_LOCAL_MAX_FILES=5
# 脱敏策略运行环境错误统计保留天数，不保存任务、用户、源码或参数。
TREND_GRID_STRATEGY_RUNTIME_ERROR_RETENTION_DAYS=180

# 信号明细批量导出。文件写入持久化 artifacts 卷，由独立执行器异步生成。
TREND_GRID_SIGNAL_EXPORT_RETENTION_HOURS=24
TREND_GRID_SIGNAL_EXPORT_TASK_RETENTION_DAYS=30
TREND_GRID_SIGNAL_EXPORT_STALE_PART_HOURS=24
TREND_GRID_SIGNAL_EXPORT_CLEANUP_SECONDS=300
TREND_GRID_SIGNAL_EXPORT_LEASE_SECONDS=90
TREND_GRID_SIGNAL_EXPORT_HEARTBEAT_SECONDS=10
TREND_GRID_SIGNAL_EXPORT_RUNNER_TTL_SECONDS=30
TREND_GRID_SIGNAL_EXPORT_RUNNER_AVAILABILITY_REQUIRED=true
TREND_GRID_SIGNAL_EXPORT_MAX_ATTEMPTS=3
# 剩余空间低于 512 MiB 时拒绝生成，避免产出不完整 ZIP。
TREND_GRID_SIGNAL_EXPORT_MIN_FREE_BYTES=536870912

# 实验评价结果表与研究报告导出。制品默认保留 7 天。
TREND_GRID_EXPERIMENT_EXPORT_TTL_DAYS=7
TREND_GRID_EXPERIMENT_EXPORT_CLEANUP_SECONDS=300
TREND_GRID_EXPERIMENT_EXPORT_STALE_PART_HOURS=24
TREND_GRID_EXPERIMENT_EXPORT_LEASE_SECONDS=90
TREND_GRID_EXPERIMENT_EXPORT_HEARTBEAT_SECONDS=10
TREND_GRID_EXPERIMENT_EXPORT_WORKER_TTL_SECONDS=30
TREND_GRID_EXPERIMENT_EXPORT_WORKER_AVAILABILITY_REQUIRED=true
TREND_GRID_EXPERIMENT_EXPORT_MAX_ATTEMPTS=3
TREND_GRID_EXPERIMENT_EXPORT_MIN_FREE_BYTES=536870912

# xlquant_pro research-signal integration through the server-local SSH tunnel.
RESEARCH_SIGNAL_API_URL=
RESEARCH_SIGNAL_SERVICE_TOKEN=
TREND_GRID_RESEARCH_AUTH_SERVICE_TOKEN=
# 本机使用 local/false；正式服务器使用 server/true。
BACKTEST_INSTANCE_ID=local
RESEARCH_RESULT_REPORT_ENABLED=false

# Research center callback endpoint hosted by the research backend.
TREND_GRID_RESEARCH_CENTER_CALLBACK_URL=
